# Copy to /etc/personal-site/nas-monitor.env on the NAS and fill values there.
# Do not commit real secrets, local IP addresses, usernames, or passwords.

NAS_MONITOR_ENDPOINT=https://your-site.example/api/monitor/nas/report
NAS_MONITOR_SECRET=replace-with-random-32-plus-character-secret
NAS_DEVICE_ID=fnos-nas
NAS_DEVICE_NAME=fnOS NAS
NAS_DEVICE_HOST=nas.local
NAS_MONITOR_INTERVAL=15
NAS_MONITOR_TIMEOUT=10

# Comma-separated data volume mount points to monitor. Configure actual NAS data volumes.
# The monitor de-duplicates paths that resolve to the same filesystem device.
NAS_MONITOR_PATHS=/vol1,/vol2
