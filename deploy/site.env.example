HOST=127.0.0.1
PORT=3010
SITE_ORIGIN=https://203.0.113.10
DATA_DIR=/var/lib/personal-site
AUTH_USERNAME=codex
AUTH_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
CODEX_WEB_URL=https://203.0.113.10:8443
MONITORING_MODE=live
MONITORING_REFRESH_INTERVAL_MS=5000
MONITORING_HISTORY_LIMIT=60
SERVER_ID=cloud-01
SERVER_NAME=Cloud 01
SERVER_REGION=上海 · 阿里云
SERVER_IP=203.0.113.10
# Renewal date on the local monitor card. YYYY-MM-DD, or an ISO-8601
# timestamp converted to the Asia/Shanghai calendar day. Empty or invalid
# values show 未设置. This is display metadata, not a credential.
# SERVER_EXPIRES_AT=2027-03-01
# NAS_DEVICE_EXPIRES_AT=2028-01-31
SERVER_EXPIRES_AT=

# Remote cloud VMs. Slots 1–8 are optional; an empty ID skips that slot.
# The host running personal-site keeps sampling itself through SERVER_* above.
# Set one shared secret of at least 32 characters, or set REMOTE_CLOUD_N_SECRET
# on a single slot to override it. Leave the secret empty until you generate one.
# Do not commit real secrets. Timing uses NAS_REPORT_INTERVAL_MS, NAS_STALE_AFTER_MS,
# and NAS_MAX_CLOCK_SKEW_MS.
REMOTE_CLOUD_MONITOR_SECRET=
# REMOTE_CLOUD_1_SECRET=
REMOTE_CLOUD_1_ID=huawei-ap-southeast-1
REMOTE_CLOUD_1_NAME=华为云 · 东南亚
REMOTE_CLOUD_1_REGION=东南亚 · ap-southeast-1
REMOTE_CLOUD_1_IP=198.51.100.20
# REMOTE_CLOUD_1_EXPIRES_AT=2026-11-30
REMOTE_CLOUD_1_EXPIRES_AT=
# REMOTE_CLOUD_2_SECRET=
REMOTE_CLOUD_2_ID=huawei-cn-east-3
REMOTE_CLOUD_2_NAME=华为云 · 华东
REMOTE_CLOUD_2_REGION=华东 · cn-east-3
REMOTE_CLOUD_2_IP=192.0.2.10
# REMOTE_CLOUD_2_EXPIRES_AT=2026-11-30T16:00:00Z
REMOTE_CLOUD_2_EXPIRES_AT=

# Watermark-free save. Both downloaders stay on loopback and are deployed separately.
# XHS-Downloader (develop API) requires Authorization: Bearer. Put the token in
# XHS_API_TOKEN, or point XHS_API_TOKEN_FILE at a root:personal-site mode 640 file
# such as /etc/media-dl/xhs-api.token. DouK-Downloader does not require a token.
# DOUYIN_COOKIE is optional and is sent as the DouK detail request's cookie field.
# 入口 2 does not read DOUYIN_COOKIE, DOUYIN_API_TOKEN, or DOUYIN_API_URL.
# Daily check: node --env-file=/etc/personal-site/site.env scripts/media-selfcheck.js
XHS_API_URL=http://127.0.0.1:5556
DOUYIN_API_URL=http://127.0.0.1:5555
XHS_API_TOKEN=
XHS_API_TOKEN_FILE=/etc/media-dl/xhs-api.token
DOUYIN_API_TOKEN=
DOUYIN_COOKIE=

# Smart cutout. rembg is installed by ops on the example East China host
# (192.0.2.10, an RFC 5737 documentation address; replace it when deploying),
# not on the host that serves this site and not in another region. This
# process only dials a loopback URL. Publish rembg on 127.0.0.1 there
# (`rembg s --host 127.0.0.1 --port 7002`); its default 0.0.0.0 would
# expose it. Reach it the same way as the XHS sidecar: an existing
# xhs-remote-proxy or a loopback-only SSH forward, never a public Caddy route.
#   ssh -N -L 127.0.0.1:7002:127.0.0.1:7002 ops@192.0.2.10
# REMBG_TIMEOUT_MS=120000
REMBG_API_URL=http://127.0.0.1:7002

# Web SSH at /terminal. Slots 1–8; an empty SSH_N_ID skips the slot.
# The page shows the same name, region, and IP as the monitor card when
# SSH_N_ID matches SERVER_ID or REMOTE_CLOUD_N_ID. SSH_N_HOST is only the
# address Node dials, and it is not sent to the browser.
# On the Aliyun VM, dial loopback for the local machine and keep SERVER_IP
# as the address on the card. The two Huawei slots below use the same IDs
# as REMOTE_CLOUD_1 and REMOTE_CLOUD_2, so their card names stay aligned.
#
# Prefer a low-privilege user and a private key file (root:personal-site, mode 640).
# SERVER_SSH_* applies to SERVER_ID. REMOTE_CLOUD_N_SSH_* applies when
# SSH_N_ID equals REMOTE_CLOUD_N_ID. SSH_N_USERNAME, SSH_N_PRIVATE_KEY_FILE,
# SSH_N_PASSWORD_FILE, and SSH_N_HOST_FINGERPRINT override those per slot.
# If both a key and a password are set, the key is tried first and the password
# is the fallback. A missing or unreadable key file does not fall back.
# Leave the password file only until the key login works.
#
# Host key pins are required. Without one, /terminal refuses the connection.
# Collect SHA256 fingerprints with:
#   ssh-keyscan -t ed25519,ecdsa,rsa -p 22 HOST | ssh-keygen -lf -
# On the host itself: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
# Paste one or more SHA256 tokens, separated by commas. SSH_HOSTKEY_TOFU=1
# accepts whatever key is presented only when no pin is configured. It does
# not remember that key, and a configured pin is still enforced. Leave it unset.
# Do not commit real keys, passwords, or tokens.
SSH_IDLE_TIMEOUT_MS=600000
SSH_MAX_SESSIONS=4
SSH_MAX_SESSION_BYTES=33554432
SSH_READY_TIMEOUT_MS=15000
SSH_MAX_SESSION_MS=14400000
# SSH_HOSTKEY_TOFU=1
SERVER_SSH_USERNAME=ops
SERVER_SSH_PRIVATE_KEY_FILE=/etc/personal-site/ssh/aliyun.key
# SERVER_SSH_PASSWORD_FILE=/etc/personal-site/ssh/aliyun.pass
# SERVER_SSH_HOSTKEY=SHA256:paste-from-ssh-keygen
SSH_1_ID=cloud-01
SSH_1_HOST=127.0.0.1
SSH_1_PORT=22
# SSH_1_USERNAME=
# SSH_1_PRIVATE_KEY_FILE=
# SSH_1_PASSWORD_FILE=
# SSH_1_HOST_FINGERPRINT=
REMOTE_CLOUD_1_SSH_USERNAME=ops
REMOTE_CLOUD_1_SSH_PRIVATE_KEY_FILE=/etc/personal-site/ssh/huawei-ap-southeast-1.key
# REMOTE_CLOUD_1_SSH_PASSWORD_FILE=/etc/personal-site/ssh/huawei-ap-southeast-1.pass
# REMOTE_CLOUD_1_SSH_HOSTKEY=SHA256:paste-from-ssh-keygen
SSH_2_ID=huawei-ap-southeast-1
SSH_2_PORT=22
REMOTE_CLOUD_2_SSH_USERNAME=ops
REMOTE_CLOUD_2_SSH_PRIVATE_KEY_FILE=/etc/personal-site/ssh/huawei-cn-east-3.key
# REMOTE_CLOUD_2_SSH_PASSWORD_FILE=/etc/personal-site/ssh/huawei-cn-east-3.pass
# REMOTE_CLOUD_2_SSH_HOSTKEY=SHA256:paste-from-ssh-keygen
SSH_3_ID=huawei-cn-east-3
SSH_3_PORT=22
