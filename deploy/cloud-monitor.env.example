# Copy to /etc/personal-site/cloud-monitor.env on each Huawei Cloud VM (mode 600).
# Do not commit real secrets. One file per VM; change the device identity block.
#
# SITE_ORIGIN for the personal-site host is https://47.117.181.103
# The reporter posts CPU, memory, root disk, and uptime to:
#   https://47.117.181.103/api/monitor/remote/report
# CLOUD_MONITOR_SECRET must match REMOTE_CLOUD_MONITOR_SECRET in the site env,
# or REMOTE_CLOUD_N_SECRET when that VM has its own secret.

CLOUD_MONITOR_ENDPOINT=https://47.117.181.103/api/monitor/remote/report
CLOUD_MONITOR_SECRET=replace-with-random-32-plus-character-secret
CLOUD_MONITOR_INTERVAL=15
CLOUD_MONITOR_TIMEOUT=10

# VM 183.87.149.115 — Huawei Cloud ap-southeast-1.
CLOUD_DEVICE_ID=huawei-ap-southeast-1
CLOUD_DEVICE_NAME=华为云 · 东南亚
CLOUD_DEVICE_REGION=东南亚 · ap-southeast-1
CLOUD_DEVICE_IP=183.87.149.115

# VM 1.94.16.40 — Huawei Cloud cn-east-3.
# Replace the four CLOUD_DEVICE_* lines above with:
# CLOUD_DEVICE_ID=huawei-cn-east-3
# CLOUD_DEVICE_NAME=华为云 · 华东
# CLOUD_DEVICE_REGION=华东 · cn-east-3
# CLOUD_DEVICE_IP=1.94.16.40

# Optional extra mount points. The root filesystem is always the disk total.
# Paths on the same filesystem as / are ignored. Leave unset on a normal VM.
# CLOUD_MONITOR_PATHS=
